# Copy to `.env` to configure vision. NOTHING here is required: with no config
# the pipeline runs fully locally — semantic vision via a local Ollama model if
# one is reachable, otherwise the metrics-only critic. No key, no cloud, no cost.

# ---- Vision provider selection --------------------------------------------
#   auto      -> anthropic if ANTHROPIC_API_KEY set, else ollama if reachable,
#                else local metrics-only
#   ollama    -> force 100% local VLM via Ollama (recommended: free + private)
#   anthropic -> force Anthropic multimodal (needs a paid key, below)
#   local     -> force metrics-only heuristics (no VLM, no network)
VISION_PROVIDER=ollama

# ---- Local VLM via Ollama (free, offline, zero-cost) ----------------------
# Install Ollama once (winget install Ollama.Ollama), then:
#   python -m pipeline.run setup --pull --test
# Swap the model freely — the code needs no other change:
#   moondream       ~1.7 GB  (fastest / lowest RAM)
#   qwen2.5vl:3b    ~3.2 GB  (default; best accuracy/speed on CPU)
#   qwen2.5vl:7b    ~6.0 GB  (stronger, needs more RAM/VRAM)
VISION_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434

# ---- Anthropic multimodal (OPTIONAL, paid) --------------------------------
# Leave blank to stay fully local/free. Provide a key only if you want to use
# Claude for tagging/critique instead of the local model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
