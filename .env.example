# Copy to `.env` and fill in to enable true multimodal vision understanding.
# WITHOUT a key the pipeline still runs end-to-end using the local metrics
# critic (no network) — it just won't have semantic scene understanding.

# Anthropic multimodal (semantic keyframe tagging + rendered-draft critique)
ANTHROPIC_API_KEY=
# Model id (multimodal, swappable). Defaults to a current Claude vision model.
ANTHROPIC_MODEL=claude-sonnet-5

# Vision provider selection: auto | anthropic | local
#   auto  -> anthropic when ANTHROPIC_API_KEY is set, else local
VISION_PROVIDER=auto
